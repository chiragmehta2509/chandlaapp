						],
						"url": {
							"raw": "{{base_url}}/api/notifications/{{notification_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"notifications",
								"{{notification_id}}"
							]
						},
						"description": "Deletes a specific notification from the authenticated user's history."
					},
					"response": []
				}
			]
		},
		{
			"name": "Admin Notifications",
			"item": [
				{
					"name": "Send Notification (To All)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{admin_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"New Feature Announcement\",\n    \"message\": \"Check out our brand new multi-ledger sync capability!\",\n    \"image\": \"https://example.com/assets/new_feature.png\",\n    \"action_type\": \"feature\",\n    \"action_value\": \"multi_ledger_sync\",\n    \"send_to\": \"all\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/admin/notifications/send",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"admin",
								"notifications",
								"send"
							]
						},
						"description": "Send a push notification to all active devices and log it to the notifications log history. Admin credentials required."
					},
					"response": []
				},
				{
					"name": "Send Notification (To Selected Users)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{admin_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"Exclusive Premium Discount\",\n    \"message\": \"Get 50% off Premium upgrade today!\",\n    \"image\": \"https://example.com/assets/offer.png\",\n    \"action_type\": \"offer\",\n    \"action_value\": \"discount_50\",\n    \"send_to\": \"selected_users\",\n    \"user_ids\": [1, 2]\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/admin/notifications/send",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"admin",
								"notifications",
								"send"
							]
						},
						"description": "Send a push notification targeting a specific array of user IDs. Admin credentials required."
					},
					"response": []
				},
				{
					"name": "Schedule Notification",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{admin_token}}",
									"type": "string"
								}
							]
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"Scheduled App Update\",\n    \"message\": \"A new version of Chandla Book is scheduled for rollout.\",\n    \"image\": null,\n    \"action_type\": \"none\",\n    \"action_value\": null,\n    \"send_to\": \"all\",\n    \"schedule_at\": \"2026-12-31 18:00:00\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/admin/notifications/send",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"admin",
								"notifications",
								"send"
							]
						},
						"description": "Creates a scheduled notification with 'pending' status, to be run at a later time."
					},
					"response": []
				}
			]
		}
