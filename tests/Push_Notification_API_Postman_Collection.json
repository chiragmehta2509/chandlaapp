{
	"info": {
		"_postman_id": "bc37ad75-b6a8-4c9b-b9f4-85ffea97a30c",
		"name": "Chandla Book Push Notifications API",
		"description": "API collection for the newly added Push Notification module in Chandla Book. Contains device token registration, administrative send endpoints, user history, and status updates.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Device Token",
			"item": [
				{
					"name": "Register Device Token",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{auth_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"device_token\": \"fcm_token_device_example_1234567890\",\n    \"platform\": \"android\",\n    \"device_name\": \"Google Pixel 8\",\n    \"app_version\": \"1.2.0\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/device-token",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"device-token"
							]
						},
						"description": "Registers or updates a device FCM token for the authenticated user. Prevents duplicate device token entries by updating details if the token already exists."
					},
					"response": []
				}
			]
		},
		{
			"name": "User Notifications",
			"item": [
				{
					"name": "Get Notification History",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{auth_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/notifications?per_page=15&page=1",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"notifications"
							],
							"query": [
								{
									"key": "per_page",
									"value": "15"
								},
								{
									"key": "page",
									"value": "1"
								}
							]
						},
						"description": "Returns a paginated list of notifications received by the authenticated user, sorted latest first."
					},
					"response": []
				},
